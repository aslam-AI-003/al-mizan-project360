// Al-Mizan Project360 — Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
}

enum ProjectStatus {
  PLANNING
  STARTED
  IN_PROGRESS
  ON_HOLD
  DELAYED
  COMPLETED
}

enum WorkerType {
  MASON
  HELPER
  CARPENTER
  ELECTRICIAN
  PLUMBER
  PAINTER
  WELDER
  OTHER
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  OVERTIME
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
}

enum InventoryTxnType {
  OPENING
  PURCHASE
  USAGE
  TRANSFER_IN
  TRANSFER_OUT
}

enum ExpenseCategory {
  TRANSPORT
  FOOD
  TOOLS
  WATER
  LOADING_UNLOADING
  LABOUR_ADVANCE
  VEHICLE
  MISCELLANEOUS
  OTHER
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  avatarUrl    String?
  createdAt    DateTime @default(now())

  supervisorProjects ProjectSupervisor[]
  dailyReportsMade   DailyReport[]
  photosUploaded     ProjectPhoto[]
  purchasesRecorded  Purchase[]
  expensesCreated    Expense[]
}

model ProjectSupervisor {
  id           String   @id @default(cuid())
  projectId    String
  supervisorId String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supervisor   User     @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([projectId, supervisorId])
}

model Project {
  id                     String        @id @default(cuid())
  name                   String
  siteAddress            String
  description            String?
  clientName             String
  projectManager         String?
  budget                 Float
  contractValue          Float
  startDate              DateTime
  expectedCompletionDate DateTime
  status                 ProjectStatus @default(PLANNING)
  overallProgress        Int           @default(0)
  archived               Boolean       @default(false)
  createdAt              DateTime      @default(now())

  supervisors    ProjectSupervisor[]
  workers        Worker[]
  attendance     WorkerAttendance[]
  workerPayments WorkerPayment[]
  inventory      Inventory[]
  inventoryTxns  InventoryTransaction[]
  purchases      Purchase[]
  expenses       Expense[]
  labourEntries  LabourEntry[]
  dailyReports   DailyReport[]
  photos         ProjectPhoto[]
  progressStages ProgressStage[]
}

model Worker {
  id          String       @id @default(cuid())
  workerCode  String       @unique
  name        String
  mobile      String
  workerType  WorkerType
  dailyWage   Float
  status      WorkerStatus @default(ACTIVE)
  joiningDate DateTime
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  createdAt   DateTime     @default(now())

  attendance WorkerAttendance[]
  payments   WorkerPayment[]
}

model WorkerAttendance {
  id            String           @id @default(cuid())
  workerId      String
  worker        Worker           @relation(fields: [workerId], references: [id])
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id])
  date          DateTime
  status        AttendanceStatus
  overtimeHours Float            @default(0)
  wageAmount    Float
  createdAt     DateTime         @default(now())

  @@unique([workerId, date])
}

model WorkerPayment {
  id              String      @id @default(cuid())
  workerId        String
  worker          Worker      @relation(fields: [workerId], references: [id])
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id])
  amount          Float
  paymentDate     DateTime
  mode            PaymentMode
  referenceNumber String?
  remarks         String?
  createdAt       DateTime    @default(now())
}

model Material {
  id       String @id @default(cuid())
  name     String @unique
  unit     String
  category String

  inventory Inventory[]
  txns      InventoryTransaction[]
  purchases Purchase[]
}

model Inventory {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  materialId   String
  material     Material @relation(fields: [materialId], references: [id])
  currentStock Float    @default(0)
  lowStockAt   Float    @default(10)

  @@unique([projectId, materialId])
}

model InventoryTransaction {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id])
  materialId        String
  material          Material         @relation(fields: [materialId], references: [id])
  type              InventoryTxnType
  quantity          Float
  date              DateTime         @default(now())
  notes             String?
  transferProjectId String?
}

/// A material bought for a site, entered in the Daily Entry. It adds to site
/// stock and counts as that day's material charge. Bought on credit unless a
/// SupplierPayment covers it — supplier pending = purchases − payments.
model Purchase {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  materialId   String
  material     Material  @relation(fields: [materialId], references: [id])
  quantity     Float
  unit         String
  rate         Float
  totalAmount  Float
  date         DateTime
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  /// Deprecated: replaced by supplierId. Kept so older deployments keep working during rollout.
  vendorName   String?
  billPhotoUrl String?
  remarks      String?
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  createdAt DateTime @default(now())

  purchases Purchase[]
  payments  SupplierPayment[]
}

model SupplierPayment {
  id         String      @id @default(cuid())
  supplierId String
  supplier   Supplier    @relation(fields: [supplierId], references: [id])
  amount     Float
  date       DateTime
  mode       PaymentMode
  note       String?
  createdAt  DateTime    @default(now())
}

/// One day's labour charge for a project, without worker names.
model LabourEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  date      DateTime
  workers   Int
  amount    Float
  note      String?
  createdAt DateTime @default(now())

  @@index([projectId, date])
}

model Expense {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id])
  category        ExpenseCategory
  amount          Float
  date            DateTime
  description     String
  paidBy          String
  paymentMode     PaymentMode
  receiptPhotoUrl String?
  createdById     String
  createdBy       User            @relation(fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
}

model DailyReport {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id])
  date               DateTime
  workCompleted      String
  workCategory       String
  progressPercentage Int
  workersCount       Int
  materialsUsed      String
  issues             String?
  tomorrowPlan       String?
  remarks            String?
  createdById        String
  createdBy          User     @relation(fields: [createdById], references: [id])
  createdAt          DateTime @default(now())

  photos ProjectPhoto[]
}

model ProjectPhoto {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id])
  dailyReportId String?
  dailyReport   DailyReport? @relation(fields: [dailyReportId], references: [id])
  url           String
  caption       String
  workCategory  String
  uploadedById  String
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime     @default(now())
}

model ProgressStage {
  id                 String      @id @default(cuid())
  projectId          String
  project            Project     @relation(fields: [projectId], references: [id])
  name               String
  order              Int
  plannedStart       DateTime
  plannedEnd         DateTime
  actualStart        DateTime?
  actualEnd          DateTime?
  progressPercentage Int         @default(0)
  status             StageStatus @default(NOT_STARTED)
  remarks            String?
}
